{
    "compilerOptions": {
        "target": "ES2017",
        "lib": ["dom", "dom.iterable", "esnext"],
        "allowJs": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "incremental": true,
        "module": "esnext",
        "esModuleInterop": true,
        "moduleResolution": "bundler",
        "allowArbitraryExtensions": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": [
        "**/*.d.ts",
        "*.ts",
        "**/*.ts",
        "**/*.tsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/declare.d.ts"
    ],
    "exclude": ["node_modules"]
}
